<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title data-i18n="ordering.page_title">行動並び替えモード</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>

<!-- 言語切り替えセレクトボックス（画面右上） -->
<div style="position: absolute; top: 20px; right: 20px; z-index: 100;">
<select id="language-select" onchange="window.setLanguage(this.value)" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #ccc; background: #fff; cursor: pointer;">
  <option value="ja">日本語</option>
  <option value="en">English</option>
  <option value="es">Español</option>
  <option value="pt">Português</option>
</select>
</div>

<div class="full-screen-container">
  <h2 class="difficulty-title" data-i18n="ordering.title">行動並び替えモード</h2>
  <p class="page-lead" data-i18n="ordering.lead">上のカードを選んで、下の1〜4の枠に順番通りに置いてください。</p>

  <div class="ordering-list">
    <% @ordering_sets.each_with_index do |set, set_index| %>
    <div class="ordering-card" data-answer="<%= set[:answer].join(',') %>">
      <!-- セットのタイトル（例: 正しい入室・着席の流れ） -->
      <h3 class="ordering-title" data-i18n="ordering.set_title_1"><%= set[:title] %></h3>
      
      <!-- ① 上部：選べるカード置き場 -->
      <div class="card-bank" id="bank-<%= set_index %>">
        <% set[:items].shuffle.each do |item| %>
        <div class="source-card" data-id="<%= item[:id] %>">
          <img src="<%= item[:image] %>" alt="" class="card-img">
        </div>
        <% end %>
      </div>

      <!-- ② 下部：1〜4の配置スロット -->
      <div class="slots-container" id="slots-<%= set_index %>">
        <% (1..set[:items].length).each do |i| %>
        <div class="order-slot" data-slot-index="<%= i - 1 %>">
          <span class="slot-number"><%= i %></span>
          <div class="slot-content"></div>
        </div>
        <% end %>
      </div>

      <div class="ordering-actions">
        <!-- やり直すボタン -->
        <button type="button" class="ordering-reset" data-target="<%= set_index %>" data-i18n="ordering.reset">やり直す</button>
        <!-- 確認ボタン -->
        <button type="button" class="ordering-check" data-target="<%= set_index %>" data-i18n="ordering.check">確認</button>
      </div>
      <div class="ordering-result" id="result-<%= set_index %>"></div>
    </div>
    <% end %>
  </div>

  <a href="/modes" class="back-link" data-i18n="ordering.back_to_modes">← モード選択に戻る</a>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.ordering-card').forEach((cardCard) => {
    const bank = cardCard.querySelector('.card-bank');
    const slots = cardCard.querySelectorAll('.order-slot');
    const checkBtn = cardCard.querySelector('.ordering-check');
    const resetBtn = cardCard.querySelector('.ordering-reset');
    const resultDiv = cardCard.querySelector('.ordering-result');

    let selectedCard = null;

    // 1. 上のカードをクリックしたとき
    bank.addEventListener('click', (e) => {
      const card = e.target.closest('.source-card');
      if (!card) return;

      bank.querySelectorAll('.source-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      selectedCard = card;
    });

    // 2. 下のスロットをクリックしたとき
    slots.forEach(slot => {
      slot.addEventListener('click', () => {
        const slotContent = slot.querySelector('.slot-content');

        if (selectedCard) {
          if (slotContent.children.length > 0) {
            bank.appendChild(slotContent.firstElementChild);
          }
          slotContent.appendChild(selectedCard);
          selectedCard.classList.remove('selected');
          selectedCard = null;
        } else if (slotContent.children.length > 0) {
          bank.appendChild(slotContent.firstElementChild);
        }
      });
    });

    // 3. やり直すボタン
    resetBtn.addEventListener('click', () => {
      slots.forEach(slot => {
        const slotContent = slot.querySelector('.slot-content');
        if (slotContent.children.length > 0) {
          bank.appendChild(slotContent.firstElementChild);
        }
      });
      resultDiv.textContent = '';
      resultDiv.className = 'ordering-result';
    });

    // 4. 確認ボタン
    checkBtn.addEventListener('click', () => {
      const currentAnswer = Array.from(slots).map(slot => {
        const card = slot.querySelector('.source-card');
        return card ? card.dataset.id : '';
      });

      // 💡 window.getI18nText を使って、選択中の言語のメッセージを取得する
      if (currentAnswer.includes('')) {
        resultDiv.textContent = window.getI18nText('ordering.alert_fill_all');
        resultDiv.className = 'ordering-result incorrect';
        return;
      }

      const answerString = currentAnswer.join(',');
      const correctAnswer = cardCard.dataset.answer;

      if (answerString === correctAnswer) {
        resultDiv.textContent = window.getI18nText('ordering.correct_msg');
        resultDiv.className = 'ordering-result correct';
      } else {
        resultDiv.textContent = window.getI18nText('ordering.incorrect_msg');
        resultDiv.className = 'ordering-result incorrect';
      }
    });
  });
});
</script>

<!-- 共通の多言語切り替えスクリプト -->
<script src="/js/i18n.js"></script>
</body>
</html>
