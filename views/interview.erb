<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>面接練習</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="interview-container">
  <header class="interview-header">
    <div class="header-info">
      <span class="mode-title" id="mode-title">面接</span>
      <span class="difficulty-badge" id="difficulty-badge"></span>
    </div>
  </header>

  <main class="interview-main">
    <div class="image-preload" aria-hidden="true" role="presentation">
      <img src="/images/body_honban.png" alt="">
      <img src="/images/mouth_1.png" alt="">
      <img src="/images/mouth_2.png" alt="">
      <img src="/images/mouth_3.png" alt="">
      <img src="/images/mouth_4.png" alt="">
      <img src="/images/mouth_5.png" alt="">
      <img src="/images/mouth_close.png" alt="">
      <img src="/images/Culcture.png" alt="">
      <img src="/images/hukurou.png" alt="">
      <img src="/images/hukuroudemo.png" alt=""> <!-- 追加 -->
      <img src="/images/kuchibashi1.png" alt="">
      <img src="/images/kuchibashi2.png" alt="">
    </div>

    <div class="speech-bubble">
      <div class="bubble-header">面接官</div>
      <div class="bubble-content" id="interviewer-text">
        準備ができたら「音声対話スタート」を押してください。
      </div>
    </div>

    <div class="interviewer-avatar" id="interviewer-avatar">
      <img class="character-base" src="/images/body_honban.png" alt="面接官">
      <img class="character-mouth" id="interviewer-mouth" src="/images/mouth_close.png" alt="面接官の口">
    </div>

    <div class="coach-panel hidden" id="coach-panel">
      <!-- ▼ ここを hukuroudemo.pngに変更 ▼ -->
      <img class="coach-avatar" src="/images/hukuroudemo.png" alt="コーチ">
      <div class="coach-bubble">
        <div class="coach-bubble-title">フクロウ先生からアドバイス</div>
        <div class="coach-bubble-body" id="coach-text"></div>
      </div>
    </div>
  </main>

  <footer class="interview-footer">
    <div class="input-section">
      <button type="button" class="send-btn" id="mic-btn">音声対話スタート</button>
      <a href="/modes" class="btn-secondary">モード選択に戻る</a>
    </div>
  </footer>
</div>

<div class="eval-modal hidden" id="eval-modal">
  <div class="eval-window">
    <div class="eval-header">
      <!-- ▼ ここを hukuroudemo.pngに変更 ▼ -->
      <img src="/images/hukuroudemo.png" alt="コーチ">
      <h2>面接評価結果</h2>
    </div>
    <div class="eval-content">
      <div class="eval-bubble score-bubble">
        <div class="bubble-title">採点結果</div>
        <div class="bubble-body" id="eval-score">評価を読み込んでいます...</div>
      </div>
      <div class="eval-bubble advice-bubble">
        <div class="bubble-title">アドバイス</div>
        <div class="bubble-body" id="eval-advice">アドバイスを読み込んでいます...</div>
      </div>
    </div>
    <div class="eval-footer">
      <a href="/modes" class="btn-secondary">モード選択に戻る</a>
      <a href="/interview?mode=<%= @mode %>&difficulty=<%= @difficulty %>" class="btn-primary">もう一度</a>
    </div>
  </div>
</div>

<script>
  window.INTERVIEW_CONFIG = {
    mode: "<%= @mode %>",
    difficulty: "<%= @difficulty %>"
  };
</script>
<script src="/script.js"></script>
</body>
</html>
