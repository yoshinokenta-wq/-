<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title data-i18n="app.page_title">面接練習 - トップ</title>
<link rel="stylesheet" href="/style.css">
<style>
  /* 画面右上に言語選択セレクトボックスを配置するスタイル */
  .language-container {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 100;
  }
  .lang-selector {
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #ccc;
    background-color: #fff;
    font-size: 14px;
    cursor: pointer;
  }
</style>
</head>
<body>

<!-- 言語切り替えセレクトボックス -->
<div class="language-container">
<select id="language-select" onchange="window.setLanguage(this.value)" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #ccc; background: #fff; cursor: pointer;">
  <option value="ja">日本語</option>
  <option value="en">English</option>
</select>
</div>

<div class="main-container">
  <div class="title-ui">
    <h1><img class="title-img" src="/images/Culcture.png" alt="Culture"></h1>
    <p data-i18n="app.subtitle">外国籍の中学生向け 高校入試面接練習</p>
  </div>

  <div class="menu-buttons">
    <a href="/modes" class="btn" data-i18n="menu.mode_select">モード選択</a>
  </div>
</div>

<!-- 共通の多言語切り替えスクリプトを読み込む -->
<script src="/js/i18n.js"></script>
</body>
</html>
