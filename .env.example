# Gemini API Key (Required for live connection to Gemini 3.8 Live API)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (Default: models/gemini-3.8-live)
GEMINI_MODEL=models/gemini-3.8-live

# Gemini Prebuilt Voice (Puck, Aoede, Charon, Kore, Fenrir)
GEMINI_VOICE=Puck

# Server Port and Host
PORT=14567
HOST=0.0.0.0
