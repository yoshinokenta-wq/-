<link rel="stylesheet" href="/style.css">

<div class="full-screen-container">
  <h2 class="page-title">モード選択</h2>

  <div class="staggered-grid">
    <!-- 左上：練習モード -->
    <a href="/interview?mode=practice" class="mode-card step-1">
      <div class="card-front">
        <span class="mode-title">練習モード</span>
      </div>
      <div class="card-back">
        <p class="description">練習モード：一問一答でその都度アドバイスをします。</p>
        <span class="start-text">クリックで開始 →</span>
      </div>
    </a>

    <!-- 右上：本番モード -->
    <a href="/interview?mode=real" class="mode-card step-2">
      <div class="card-front">
        <span class="mode-title">本番モード</span>
      </div>
      <div class="card-back">
        <p class="description">本番モード：基本的な面接の流れを再現し、最後にアドバイス、採点結果を表示します。</p>
        <span class="start-text">クリックで開始 →</span>
      </div>
    </a>

    <!-- 左下：単語帳モード -->
    <a href="/interview?mode=vocab" class="mode-card step-3">
      <div class="card-front">
        <span class="mode-title">単語帳モード</span>
      </div>
      <div class="card-back">
        <p class="description">単語帳モード：面接に使える単語について学ぶことができます。</p>
        <span class="start-text">クリックで開始 →</span>
      </div>
    </a>

    <!-- 右下：行動並び替えモード -->
    <a href="/interview?mode=sort" class="mode-card step-4">
      <div class="card-front">
        <span class="mode-title">行動並び替えモード</span>
      </div>
      <div class="card-back">
        <p class="description">行動並び替えモード：面接の動作の流れをカードの並び替えで学ぶことができます。</p>
        <span class="start-text">クリックで開始 →</span>
      </div>
    </a>
  </div>

  <a href="/" class="back-link">← トップに戻る</a>
</div>