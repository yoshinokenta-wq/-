<link rel="stylesheet" href="/style.css">

<div class="main-container">
  <h2>⚙️ 言語設定</h2>

  <form action="/" method="GET" class="answer-form">
    <label for="language"><strong>使用する言語を選択してください：</strong></label>
    <select name="lang" id="language" style="width: 100%; padding: 12px; margin: 15px 0; border-radius: 8px; font-size: 1rem;">
      <option value="ja">日本語 (Japanese)</option>
      <option value="en">英語 (English)</option>
    </select>

    <button type="submit" class="btn">設定を保存して戻る</button>
  </form>

  <a href="/" class="back-link">← トップに戻る</a>
</div>